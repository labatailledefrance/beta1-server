{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Objet",
  "description": "Un objet du catalogue : une table, nommée par son genre.",
  "oneOf": [
    {
      "description": "Type de zombie : déplacement, perception, alerte, contagion (ZOMBIES.md).",
      "type": "object",
      "properties": {
        "zombie": {
          "$ref": "#/$defs/Zombie"
        }
      },
      "additionalProperties": false,
      "required": [
        "zombie"
      ]
    },
    {
      "description": "Scénario : état initial du monde (G-06).",
      "type": "object",
      "properties": {
        "scenario": {
          "$ref": "#/$defs/Scenario"
        }
      },
      "additionalProperties": false,
      "required": [
        "scenario"
      ]
    }
  ],
  "$defs": {
    "Rectangle": {
      "description": "Rectangle de tiles, bornes comprises, en kilomètres dans la projection de sa zone.",
      "type": "object",
      "properties": {
        "x": {
          "description": "Colonnes [min, max] (km vers l'est).",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "int32"
          },
          "maxItems": 2,
          "minItems": 2
        },
        "y": {
          "description": "Lignes [min, max] (km vers le nord).",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "int32"
          },
          "maxItems": 2,
          "minItems": 2
        },
        "zone": {
          "description": "Zone de projection.",
          "$ref": "#/$defs/ZoneProjection"
        }
      },
      "additionalProperties": false,
      "required": [
        "zone",
        "x",
        "y"
      ]
    },
    "Scenario": {
      "description": "Scénario : ce qui existe au démarrage du monde.",
      "type": "object",
      "properties": {
        "tiles_actives": {
          "description": "Tiles actives au démarrage, en attendant que les unités les activent.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Rectangle"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "tiles_actives"
      ]
    },
    "Zombie": {
      "description": "Paramètres d'un type de zombie. Valeurs de départ : celles de P-26.",
      "type": "object",
      "properties": {
        "cone_vision": {
          "description": "Cône de vision en errance (degrés) ; en chasse, il voit tout autour.",
          "type": "number",
          "format": "double",
          "maximum": 360.0,
          "minimum": 0.0
        },
        "delai_zombification": {
          "description": "Délai de zombification d'un humain mordu (s).",
          "type": "number",
          "format": "double",
          "maximum": 3600.0,
          "minimum": 0.05
        },
        "duree_attirance": {
          "description": "Durée d'attirance par un bruit ou une fumée (s).",
          "type": "number",
          "format": "double",
          "maximum": 3600.0,
          "minimum": 0.05
        },
        "ecart_vitesse": {
          "description": "Écart de vitesse d'un zombie à l'autre, en fraction (0,18 : de -18 % à +18 %).",
          "type": "number",
          "format": "double",
          "maximum": 0.5,
          "minimum": 0.0
        },
        "facteur_eau": {
          "description": "Facteur de vitesse dans l'eau peu profonde.",
          "type": "number",
          "format": "double",
          "maximum": 1.0,
          "minimum": 0.05
        },
        "fraicheur_alerte": {
          "description": "Âge maximal d'une alerte encore relayée (s).",
          "type": "number",
          "format": "double",
          "maximum": 600.0,
          "minimum": 0.05
        },
        "memoire_proie": {
          "description": "Durée pendant laquelle il poursuit une proie perdue de vue (s).",
          "type": "number",
          "format": "double",
          "maximum": 3600.0,
          "minimum": 0.05
        },
        "perception_chasse": {
          "description": "Période de perception en chasse (s).",
          "type": "number",
          "format": "double",
          "maximum": 60.0,
          "minimum": 0.05
        },
        "perception_errance": {
          "description": "Période de perception en errance (s).",
          "type": "number",
          "format": "double",
          "maximum": 60.0,
          "minimum": 0.05
        },
        "periode_cap": {
          "description": "Période de changement de cap en errance (s).",
          "type": "number",
          "format": "double",
          "maximum": 600.0,
          "minimum": 0.05
        },
        "rayon_contact": {
          "description": "Distance de contact, de morsure (m).",
          "type": "number",
          "format": "double",
          "maximum": 5.0,
          "minimum": 0.1
        },
        "rayon_fumee": {
          "description": "Distance sous laquelle une fumée l'attire (m).",
          "type": "number",
          "format": "double",
          "maximum": 20000.0,
          "minimum": 0.0
        },
        "rayon_odorat": {
          "description": "Distance sous laquelle il sent une proie hors de son cône (m).",
          "type": "number",
          "format": "double",
          "maximum": 100.0,
          "minimum": 0.0
        },
        "rayon_relais": {
          "description": "Rayon de relais de l'alerte, de zombie à zombie (m).",
          "type": "number",
          "format": "double",
          "maximum": 50.0,
          "minimum": 0.0
        },
        "vitesse_course": {
          "description": "Vitesse de course, en chasse (m/s).",
          "type": "number",
          "format": "double",
          "maximum": 15.0,
          "minimum": 0.05
        },
        "vitesse_errance": {
          "description": "Vitesse en errance (m/s).",
          "type": "number",
          "format": "double",
          "maximum": 5.0,
          "minimum": 0.05
        }
      },
      "additionalProperties": false,
      "required": [
        "vitesse_errance",
        "vitesse_course",
        "ecart_vitesse",
        "facteur_eau",
        "periode_cap",
        "cone_vision",
        "rayon_odorat",
        "perception_errance",
        "perception_chasse",
        "memoire_proie",
        "rayon_relais",
        "fraicheur_alerte",
        "rayon_fumee",
        "duree_attirance",
        "rayon_contact",
        "delai_zombification"
      ]
    },
    "ZoneProjection": {
      "description": "Zone de projection d'une tile (C-01), dans l'ordre de `beta1_common::geo::ZONES`.",
      "oneOf": [
        {
          "description": "Lambert-93 : métropole.",
          "type": "string",
          "const": "LAMB93"
        },
        {
          "description": "UTM 20N : Guadeloupe, Martinique.",
          "type": "string",
          "const": "UTM20"
        },
        {
          "description": "UTM 22N : Guyane.",
          "type": "string",
          "const": "UTM22"
        },
        {
          "description": "UTM 40S : La Réunion.",
          "type": "string",
          "const": "UTM40S"
        },
        {
          "description": "UTM 38S : Mayotte.",
          "type": "string",
          "const": "UTM38S"
        },
        {
          "description": "UTM 21N : Saint-Pierre-et-Miquelon.",
          "type": "string",
          "const": "UTM21"
        }
      ]
    }
  }
}
